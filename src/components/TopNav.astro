---
import { Icon } from 'astro-icon/components'
---

<header
  class="w-full py-4 px-4 border-b border-gray-200 bg-white sticky top-0 z-50"
  role="banner"
>
  <nav
    class="max-w-6xl mx-auto flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="text-2xl font-bold text-gray-900 hover:text-gray-700 transition-colors flex items-center"
      aria-label="ParSec"
    >
      <span class="mr-1"><Icon name="logo" /></span>
      ParSec
    </a>

    <!-- Mobile menu button -->
    <button
      type="button"
      class="md:hidden p-2 text-gray-600 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-lg"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="mobile-menu-button"
    >
      |||
    </button>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex items-center gap-6" role="list">
      <li>
        <a
          href="/project"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname === '/project' ? 'page' : undefined}
        >
          Project Overview
        </a>
      </li>
      <li>
        <a
          href="/project/details"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname === '/project/details'
            ? 'page'
            : undefined}
        >
          Technical Details
        </a>
      </li>
      <li>
        <a
          href="/team"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname === '/team' ? 'page' : undefined}
        >
          Team
        </a>
      </li>
      <li>
        <a
          href="/democratizing-access"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname === '/democratizing-access'
            ? 'page'
            : undefined}
        >
          Democratizing Access Control
        </a>
      </li>
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-200 bg-white"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col py-4" role="list">
      <li>
        <a
          href="/project"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/project' ? 'page' : undefined}
        >
          Project Overview
        </a>
      </li>
      <li>
        <a
          href="/project/details"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/project/details'
            ? 'page'
            : undefined}
        >
          Technical Details
        </a>
      </li>
      <li>
        <a
          href="/team"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/team' ? 'page' : undefined}
        >
          Team
        </a>
      </li>
      <li>
        <a
          href="/democratizing-access"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/democratizing-access'
            ? 'page'
            : undefined}
        >
          Democratizing Access Control
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button')
  const mobileMenu = document.getElementById('mobile-menu')

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true'
      menuButton.setAttribute('aria-expanded', String(!isExpanded))
      mobileMenu.classList.toggle('hidden')
    })

    // outside click
    document.addEventListener('click', (e) => {
      if (
        !menuButton.contains(e.target as Node) &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenu.classList.contains('hidden')
      ) {
        menuButton.setAttribute('aria-expanded', 'false')
        mobileMenu.classList.add('hidden')
      }
    })

    // escape key close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuButton.setAttribute('aria-expanded', 'false')
        mobileMenu.classList.add('hidden')
        menuButton.focus()
      }
    })
  }
</script>
