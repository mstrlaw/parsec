---
import Layout from '../layouts/Layout.astro'
import PageTitle from '../components/PageTitle.astro'
import { Icon } from 'astro-icon/components'

const title = 'Team'

const members = [
  {
    name: 'Mike Ensley',
    photo: 'https://dummyimage.com/200x200',
    role: 'Researcher',
    bio: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Assumenda inventore voluptatibus',
    contact: 'foo@example.com',
  },
  {
    name: 'Mike Ensley',
    photo: 'https://dummyimage.com/200x200',
    role: 'Researcher',
    bio: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Assumenda inventore voluptatibus',
    contact: 'foo@example.com',
  },
  {
    name: 'Mike Ensley',
    photo: 'https://dummyimage.com/200x200',
    role: 'Researcher',
    bio: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Assumenda inventore voluptatibus',
    contact: 'foo@example.com',
  },
]
---

<Layout title={title}>
  <PageTitle title={title} />
  <p class="text-lg mb-10">
    Our team comprises researchers, developers, and domain experts from several
    academic backgrounds working together to advance access control
    technologies. We combine expertise in applied cryptography,. cybersecurity,
    distributed systems, and user experience to approach access control from
    multiple perspectives.
  </p>
  <section class="text-gray-600 body-font">
    <div class="mx-auto">
      <div class="flex justify-center -m-4">
        {
          members.map((member) => (
            <div data-attribute="team-member" class="p-4 lg:w-1/4 md:w-1/2">
              <div class="h-full flex flex-col items-center text-center">
                <img
                  alt={member.name}
                  class="flex-shrink-0 rounded-lg w-full h-56 object-cover object-center mb-4"
                  src={member.photo}
                />
                <div class="w-full">
                  <h2 class="title-font font-medium text-lg text-gray-900">
                    {member.name}
                  </h2>
                  <h3 class="text-gray-500 mb-3">{member.role}</h3>
                  <p class="mb-4">{member.bio}</p>
                  <span class="inline-flex">
                    <a
                      href={`mailto:${member.contact}`}
                      class="text-xl text-gray-500"
                    >
                      <Icon name="mail" />
                    </a>
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
