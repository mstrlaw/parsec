---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Home">
  <div
    class="hero py-10 px-6 mt-12 bg-linear-25 from-slate-600 to-slate-950 rounded-2xl"
  >
    <h1 class="text-4xl md:text-5xl font-bold text-gray-100">
      Astronomically Advancing Research in Access Control
    </h1>
    <br /><br />
    <h2 class="text-2xl text-gray-100">
      An academic initiative exploring innovative approaches to democratizing
      access control technologies for democratic institutions and organizations.
    </h2>
    <br /><br />
    <div class="flex">
      <a
        href="/project"
        class="bg-slate-300 hover:bg-slate-400 hover:cursor-pointer text-black font-bold py-2 px-4 rounded mx-auto"
      >
        Read more
      </a>
    </div>
  </div>
</Layout>

<style>
  .hero {
  }
</style>
