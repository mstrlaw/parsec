---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Home">
  <div
    class="hero py-10 px-6 mt-12 bg-linear-25 from-slate-600 to-slate-950 rounded-2xl"
  >
    <h1 class="text-4xl md:text-5xl font-bold text-gray-100">
      Astronomically Advancing Research in Access Control
    </h1>
    <br /><br />
    <h2 class="text-2xl text-gray-100">
      An academic initiative exploring innovative approaches to democratizing
      access control technologies for democratic institutions and organizations.
    </h2>
    <br /><br />
    <div class="flex">
      <a
        href="/project"
        class="bg-slate-300 hover:bg-slate-400 hover:cursor-pointer text-black font-bold py-2 px-4 rounded mx-auto"
      >
        Read more
      </a>
    </div>
  </div>
  <br />
  <section class="my-16 px-4 flex flex-col md:flex-row items-center gap-8">
    <div class="w-full md:w-1/2">
      <p class="text-2xl text-gray-700">
        Our academic project focuses on developing and analyzing new models for
        access control systems that are more inclusive, transparent, and secure.
      </p>
      <p class="text-2xl text-gray-700 mt-4">
        Unlike other access control methods, we consider the needs of democratic
        institutions and organizations, and reject older solutions that are
        susceptible to disastrous insider attacks.
      </p>
      <div class="flex mt-8">
        <a
          href="/democratizing-access"
          class="bg-slate-800 hover:bg-slate-900 hover:cursor-pointer text-white font-bold py-2 px-4 rounded mx-auto"
        >
          Explore Democratizing Access
        </a>
      </div>
    </div>
    <div class="w-full md:w-1/2">
      <img src="/diagram.png" alt="Diagram" class="w-full rounded-lg" />
    </div>
  </section>
  <section class="my-16 px-4 flex flex-col md:flex-row items-center gap-8">
  <div class="w-full md:w-1/2">
      <div class="flex mt-8">
        <a
          href="https://github.com/pmcampones/judo"
          class="bg-slate-800 hover:bg-slate-900 hover:cursor-pointer text-white font-bold py-2 px-4 rounded mx-auto"
        >
          View the JUDO Code
        </a>
      </div>
  </div<>
  <div class="w-full md:w-1/2">
      <div class="flex mt-8">
        <a
          href="https://github.com/hugogspereira/parsec-blockchain-dapp"
          class="bg-slate-800 hover:bg-slate-900 hover:cursor-pointer text-white font-bold py-2 px-4 rounded mx-auto"
        >
          View the Blockchain Implementation
        </a>
      </div>
  </div<>
  </section>
  <br />
</Layout>

<style>
  .hero {
  }
</style>
